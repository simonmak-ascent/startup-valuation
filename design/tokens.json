{
  "brand": {
    "primary": "#0083AB",
    "dark": "#005f80"
  },
  "semantic": {
    "success": "#10b981",
    "error": "#ef4444",
    "warning": "#f59e0b",
    "info": "#3b82f6"
  },
  "surface": {
    "bg": "#f8fafc",
    "card": "#ffffff",
    "text": "#1e293b",
    "muted": "#64748b",
    "border": "#e2e8f0"
  },
  "typography": {
    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "fontFamilyMono": "'Courier New', 'Fira Code', monospace",
    "fontSizeBase": "16px",
    "lineHeightBase": 1.6,
    "headingWeight": 700,
    "headingLetterSpacing": "-0.5px"
  },
  "spacing": {
    "sectionPadding": "4rem",
    "cardPadding": "1.5rem",
    "buttonPadding": "0.875rem 1.75rem",
    "inputPadding": "0.625rem",
    "gap": "1.5rem"
  },
  "radius": {
    "card": "0.75rem",
    "button": "0.5rem",
    "input": "0.375rem"
  },
  "animation": {
    "transition": "0.2s",
    "hoverLift": "translateY(-2px)",
    "hoverShadow": "0 8px 24px rgba(0,0,0,0.2)"
  }
}
