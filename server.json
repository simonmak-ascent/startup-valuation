{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.simonplmak-cloud/startup-valuation",
  "title": "Startup Valuation MCP Server",
  "description": "Startup valuation for AI agents: 14 tools, 80+ pre-revenue formulas.",
  "version": "2.0.0",
  "repository": {
    "url": "https://github.com/simonplmak-cloud/startup-valuation",
    "source": "github"
  },
  "websiteUrl": "https://startup-valuation.simonmak.com",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "startup-valuation",
      "version": "2.0.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "startup-valuation"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "startup-valuation-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://startup-valuation.simonmak.com/api"
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/simonplmak-cloud/startup-valuation/main/public/social-preview.png",
      "mimeType": "image/png"
    }
  ]
}
