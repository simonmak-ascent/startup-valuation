{
  "version": 1,
  "default_branch": "main",
  "merge": "pr-required",
  "verify": [
    "pytest",
    "ruff check .",
    "pnpm check",
    "pnpm test",
    "python3 -m pytest tests-ci/",
    "node --test tests-ci/workflows.test.mjs",
    "python3 tests-ci/health_gate_sim.py",
    "python3 tests-ci/sampler_sim.py"
  ],
  "deploy": {
    "kind": "workflow",
    "workflow": "deploy-digest.yml"
  },
  "e2e": [
    {
      "probe": "https://startup-valuation.ascent-partners.com/",
      "expect": 200
    },
    {
      "probe": "https://startup-valuation.ascent-partners.com/zh",
      "expect": 200
    },
    {
      "probe": "https://startup-valuation.ascent-partners.com/hk",
      "expect": 200
    },
    {
      "probe": "https://startup-valuation.ascent-partners.com/api/health",
      "note": "200 when the market-data source answers; a sustained 503 is a real product outage (the comparables have nothing to show), so this probe treats it as a failure. The 503 branch is asserted in tests-webapp/health-route.test.ts, not against the origin",
      "expect": 200
    },
    {
      "probe": "https://startup-valuation.ascent-partners.com/.well-known/mcp.json",
      "expect": 200
    },
    {
      "probe": "https://startup-valuation.ascent-partners.com/mcp",
      "expect": 405,
      "note": "405 with Allow: POST, OPTIONS once the Python service image carries the method guard; the deployed image answers 200 until that pin lands"
    }
  ]
}
