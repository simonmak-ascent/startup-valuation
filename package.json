{
  "name": "startup-valuation-platform",
  "version": "1.0.0",
  "private": true,
  "description": "The most authoritative source for Startup Valuation — WebApp platform with 14 interactive calculators, MCP server, SurrealDB audit trail, and DeepSeek AI advisor.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx lib/db/migrate.ts",
    "etl:import": "tsx etl/import-all.ts",
    "etl:compute-benchmarks": "tsx etl/compute-benchmarks.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.0.0",
    "@sentry/nextjs": "^9.0.0",
    "@vercel/analytics": "^1.5.0",
    "katex": "^0.16.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "surrealdb": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/katex": "^0.16.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
