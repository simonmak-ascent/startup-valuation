{
  "name": "startup-valuation-platform",
  "version": "2.1.4",
  "private": true,
  "description": "The most authoritative source for Startup Valuation \u2014 WebApp platform with 14 interactive calculators, MCP server, formula, assumptions and steps, and DeepSeek AI advisor.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx lib/db/migrate.ts",
    "etl:import": "tsx etl/import-all.ts",
    "test:e2e:deployed": "node --test tests-deployed/*.test.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.76.2",
    "katex": "^0.19.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "surrealdb": "^2.0.8",
    "yahoo-finance2": "^4.0.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "uuid": ">=11.1.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
