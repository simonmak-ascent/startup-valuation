# =============================================================================
# SurrealDB 3.x — application data (valuation runs, methods, public data)
# =============================================================================
SURREALDB_URL=ws://localhost:8000
SURREALDB_NS=startup_valuation
SURREALDB_DB=startup_valuation
SURREALDB_USER=root
SURREALDB_PASS=root

# =============================================================================
# SurrealDB 3.x — shared identity store (via @simonplmak-cloud/auth)
# =============================================================================
SURREAL_URL=ws://localhost:8000
SURREAL_USERNAME=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=ascent
SURREAL_DATABASE=identity

# =============================================================================
# Auth.js v5 (via @simonplmak-cloud/auth)
# =============================================================================
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_GITHUB_ID=optional_github_oauth_client_id
AUTH_GITHUB_SECRET=optional_github_oauth_client_secret
# Cross-site session cookie domain (optional; e.g. .simonmak.com)
AUTH_COOKIE_DOMAIN=

# =============================================================================
# DeepSeek LLM
# =============================================================================
DEEPSEEK_API_KEY=sk-xxx

# Sentry
SENTRY_DSN=https://xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx.ingest.sentry.io/xxx

# Vercel
VERCEL_URL=
NPM_TOKEN=ghp_xxxxxxxx  # GitHub Packages read token for @simonplmak-cloud/* deps
