# Environment for the hosted app.
#
# There is no database. Calculations are computed per request, and the comparables pages read live
# market data from Yahoo Finance, which needs no key. The SURREALDB_* keys that `lib/db/client.ts`
# still reads belong to the **offline ETL** (`pnpm etl:import`), are never required by the running
# site, and are not listed here because the site must not be configured to depend on them.

# The AI advisor (`/api/ai`). Absent, that route answers 502 and the rest of the site is unaffected.
DEEPSEEK_API_KEY=

# Sentry error telemetry, read by sentry.server.config.ts. Set in /etc/startup-valuation/*.env on the
# nodes; absent, the SDK is inert and the site works without it.
SENTRY_DSN=
