# Startup Valuation — the web application image.
#
# The repository had no Dockerfile for the site: `Dockerfile` builds the stdio MCP
# server, but the deployed `startup-valuation` container (port 3110) runs the
# Next.js app, so it could not be rebuilt from anything here (OI-40). This is that
# missing file.
#
# `next.config.ts` sets `output: "standalone"`, so the run stage needs only the
# standalone bundle plus the static assets and `public/`.

FROM node:22-slim AS deps
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:22-slim AS run
WORKDIR /app
RUN useradd --uid 1001 --create-home app
# HOSTNAME must be 0.0.0.0, never 127.0.0.1: the i18n middleware otherwise rewrites
# to an absolute localhost URL, proxies to itself and returns 500 (standards.md).
ENV NODE_ENV=production \
    PORT=3110 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=build --chown=1001:1001 /app/.next/standalone ./
COPY --from=build --chown=1001:1001 /app/.next/static ./.next/static
COPY --from=build --chown=1001:1001 /app/public ./public
USER 1001
EXPOSE 3110
CMD ["node", "server.js"]
